# Copy to .env (never commit .env). Real environment variables take precedence.

# Claude for the agents (optional - without a model provider they run in rules mode).
# You can also run `ant auth login`, or store a key under Settings > AI providers, instead of setting it here.
ANTHROPIC_API_KEY=

# OpenAI for the agents (optional; Responses API at https://api.openai.com/v1 - OPENAI_BASE_URL is ignored).
# A ChatGPT subscription does not include API access: create an API key with billing on platform.openai.com.
# Wins over a key stored under Settings > AI providers. Choose OpenAI's default model on its card there.
OPENAI_API_KEY=

# Claude's default model (change it on Claude's card under Settings > AI providers; agents can choose their own).
HUB_MODEL=claude-opus-5-5

# manual | assisted | autonomous - how much agents may do without approval.
HUB_AUTONOMY=assisted

# Where to listen. Keep 127.0.0.1 and put a TLS reverse proxy in front if others reach the hub (docs/AUTH.md).
HUB_HOST=127.0.0.1
HUB_PORT=8710
# Extra Host headers to accept, comma separated (e.g. hub.internal.example.com).
HUB_ALLOWED_HOSTS=

# Database and workspace (cloned repos, adapters, patch worktrees).
HUB_DATA_DIR=.hub

# Seconds between health sweeps of running tools.
HUB_HEALTH_INTERVAL=60

# Seconds between checks for due data flows, running vulnerability scans, scheduled team agents and network device
# changes (expiry, maintenance windows, rollback deadlines).
HUB_FLOW_INTERVAL=30

# Encryption key for stored credentials: tool and device connections (API tokens, keys, passwords), local model API
# keys and the client secret of the Sign-in & SSO settings - and for the network devices' configuration backups.
# Default: HUB_DATA_DIR/secret.key, generated on first use - back it up separately from hub.db; without it the stored
# credentials must be entered again and the device backups cannot be read. Comma-separate several keys to
# rotate (the first encrypts, all decrypt). Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUB_SECRET_KEY=

# Set to "off" to force rules mode even when credentials exist.
HUB_LLM=

# Set to "off" to stop Atrium from detecting its own git checkout, so it never proposes changes to its own code
# (self-patching; docs/AGENTS.md). The guardrail allow_self_patching in Settings switches it off as well.
HUB_SELF_PATCH=

# Subsidiaries (docs/SUBSIDIARIES.md): the sidecar image the generated bundles name - pin it by digest
# (registry/atrium-sidecar@sha256:...); default atrium-sidecar:local. HUB_BRIDGE_TESTS=off stops bridge patches from
# looking for docker or podman to run a tool's tests in (they are then shown as "not run").
HUB_SIDECAR_IMAGE=
HUB_BRIDGE_TESTS=

# Development only: 1 = register the in-memory "fake firewall" connector to try the Network app and device changes
# without a real device (docs/NETWORK.md). Never set it in production.
HUB_DEV_FAKE_DEVICES=

# --- Sign-in and sessions (docs/AUTH.md) ---

# How people reach the hub, used for the first-run setup link, the SSO redirect URI and the link in agent
# notifications sent to integrated tools (hub.agent.* on the tool bus; default http://HOST:PORT).
HUB_PUBLIC_URL=
# Sign a session out after this many minutes without activity.
HUB_SESSION_IDLE_MINUTES=720
# Sign a session out after this many days, however active.
HUB_SESSION_DAYS=7
# 1 = always mark the session cookie Secure (set it when a TLS proxy terminates HTTPS in front of the hub).
HUB_COOKIE_SECURE=
# Addresses or networks (comma separated) of the reverse proxy in front of the hub, whose X-Forwarded-For header is
# trusted - so sign-in throttling counts each client's own address. Default: 127.0.0.1 only. In Docker the proxy
# reaches the hub from the bridge gateway or its own container (e.g. 172.18.0.1 or 172.18.0.0/16).
HUB_TRUSTED_PROXIES=

# First administrator, created at start-up only while there are no accounts. Remove the password afterwards.
HUB_ADMIN_USERNAME=
HUB_ADMIN_PASSWORD=
# Fixed first-run setup token instead of a random one printed at start-up.
HUB_SETUP_TOKEN=

# --- Single sign-on with OpenID Connect (enabled when issuer and client id are set) ---
# Admins can also set this up in Settings > Sign-in & SSO (stored in the database, no restart). Every variable given a
# value here wins over the value stored there and is shown read-only, so leave a variable empty to manage that field
# in the UI; empty variables use the default named in their comment (docs/AUTH.md).

# Issuer URL, e.g. http://localhost:8080/realms/hub for examples/keycloak.
HUB_OIDC_ISSUER=
# Client registered for the hub; redirect URI is {HUB_PUBLIC_URL}/api/auth/oidc/callback.
HUB_OIDC_CLIENT_ID=
HUB_OIDC_CLIENT_SECRET=
# Scopes to request. Default: openid profile email
HUB_OIDC_SCOPES=
# Claim carrying groups or roles; dotted paths allowed (e.g. realm_access.roles). Default: groups
HUB_OIDC_ROLE_CLAIM=
# Claim values (comma separated) that grant the admin role. Default: atrium-admins
HUB_OIDC_ADMIN_VALUES=
# Claim values (comma separated) that grant the operator role. Default: atrium-operators
HUB_OIDC_OPERATOR_VALUES=
# Claim values (comma separated) that grant the viewer role - with HUB_OIDC_DEFAULT_ROLE=none. Default: none
HUB_OIDC_VIEWER_VALUES=
# Role for everyone else: viewer | operator | admin | none (none refuses their sign-in, so only members of the
# Atrium groups get in). Default: viewer (settings saved in the UI start with none)
HUB_OIDC_DEFAULT_ROLE=
# Email domains (comma separated) whose accounts may sign in - Google's hosted domain, else a verified email's
# domain. Default: any
HUB_OIDC_ALLOWED_DOMAINS=
# Text of the SSO button on the sign-in screen. Default: "Sign in with SSO" ("Sign in with <provider>" when the
# Sign-in & SSO settings name a provider).
HUB_OIDC_LABEL=
# 1 = allow a plain-http issuer that is not on localhost / 127.0.0.1 (lab use only).
HUB_OIDC_ALLOW_HTTP=
