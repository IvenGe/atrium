# The Atrium sidecar of the {{tool_id}} subsidiary ({{subsidiary_id}}), generated by Atrium. This file holds no secret.
# Install: copy config.json to /etc/atrium-sidecar/config.json and this file to /etc/systemd/system/, then see README.md
# for the first start with the one-time enrollment code.
[Unit]
Description=Atrium sidecar for {{tool_id}} ({{subsidiary_id}})
After=network-online.target
Wants=network-online.target

[Service]
ExecStart={{executable}} --config /etc/atrium-sidecar/config.json
DynamicUser=yes
StateDirectory=atrium-sidecar
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax={{memory_max}}
TasksMax=256
Restart=on-failure
RestartSec=5
# 3: the token was revoked or its owner disabled; 4: Atrium stopped the subsidiary - neither is fixed by a restart
RestartPreventExitStatus=3 4

[Install]
WantedBy=multi-user.target
